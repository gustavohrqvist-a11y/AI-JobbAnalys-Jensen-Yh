# Här placeras funktioner som används
# som stöd för programmets huvudfunktioner.

import requests


def hämta_jobb_från_api(profil):

    if not profil.jobb:
        print("Du måste ställa in din profil först.")
        return []

    url = "https://jobsearch.api.jobtechdev.se/search"

    jobbannonser = []

    try:

        for sökord in profil.jobb:

            print(f"Söker efter: {sökord}")

            params = {
                "q": sökord,
                "limit": 20
            }

            response = requests.get(
                url,
                params=params,
                timeout=10
            )

            print("Statuskod:", response.status_code)

            if response.status_code != 200:
                print("Kunde inte hämta jobbannonser.")
                print(response.text)
                continue

            data = response.json()

            print("Antal träffar:", len(data.get("hits", [])))

            # 👇 HÄR ska du ändra
            for jobb in data.get("hits", []):

                titel = (jobb.get("headline") or "").strip().lower()

                plats_info = jobb.get("workplace_address") or {}

                plats = (plats_info.get("municipality") or "").strip().lower()

                länk = jobb.get("webpage_url") or ""

                annons = Jobbannons(
                    titel,
                    plats,
                    [],
                    länk
                )

                jobbannonser.append(annons)

        return jobbannonser

    except requests.exceptions.RequestException as fel:

        print("Ett fel uppstod när API:t kontaktades.")
        print(fel)

        return []

